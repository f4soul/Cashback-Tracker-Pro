# =============================================
# Firebase Configuration (для Vite)
# =============================================

# Firebase Configuration
# Эти ключи публичные для клиентской части, но для собственного инстанса
# вам потребуется создать свой проект в Firebase Console и скопировать сюда свои данные.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# reCAPTCHA v3 Site Key для Firebase App Check (опционально)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Firestore Database ID (обычно оставляют пустым для (default))
VITE_FIREBASE_DATABASE_ID=

# =============================================
# Другие возможные переменные окружения
# =============================================
# VITE_API_URL=https://api.example.com
# VITE_DEBUG_MODE=false
