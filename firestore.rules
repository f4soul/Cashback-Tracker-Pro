rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ====================== ФУНКЦИИ ======================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email == "filimlive@gmail.com" && 
              request.auth.token.email_verified == true);
      // Если позже добавишь роль admin в users/{uid}, можно раскомментировать:
      // || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    // ====================== ВАЛИДАЦИЯ ======================
    function isValidUser(data) {
      return data.settings is map &&
             data.customBanks is list &&
             data.customCategories is list;
    }

    function isValidMonth(data) {
      return data.uid is string &&
             data.monthId is string &&
             data.entries is list &&
             data.uid == request.auth.uid;   // строго проверяем uid
    }

    // ====================== ПРАВИЛА ======================

    // Пользователи — очень строго
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    // Основная коллекция с данными по месяцам
    match /months/{monthDocId} {
      
      // Чтение: только свои документы
      allow read: if isAuthenticated() && 
                    (resource.data.uid == request.auth.uid || isAdmin());

      // Создание: только свои документы и правильный формат id
      allow create: if isAuthenticated() && 
                      isValidMonth(request.resource.data) &&
                      monthDocId.startsWith(request.auth.uid + "_");

      // Обновление: только свои документы
      allow update: if isAuthenticated() && 
                      resource.data.uid == request.auth.uid && 
                      isValidMonth(request.resource.data);

      // Удаление: только свои или админ
      allow delete: if isAuthenticated() && 
                      (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ====================== ЗАПРЕТ ВСЁГО ОСТАЛЬНОГО ======================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}