rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ====================== ФУНКЦИИ ======================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
             (request.auth.token.email == "admin@example.com" // REPLACE WITH YOUR ADMIN EMAIL &&
              request.auth.token.email_verified == true);
             // || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ====================== ВАЛИДАТОРЫ ======================
    function isValidUser(data) {
      return data.settings is map &&
             data.customBanks is list &&
             data.customCategories is list;
    }

    function isValidMonth(data) {
      return data.uid is string &&
             data.monthId is string &&
             data.entries is list;
    }

    // ====================== ПРАВИЛА ======================

    // Пользователи
    match /users/{userId} {
      allow read,   update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    // Основная коллекция месяцев
    match /months/{monthDocId} {
      
      // Чтение: свои данные + админ видит всё
      allow read: if isAuthenticated() && 
                    (resource.data.uid == request.auth.uid || isAdmin());

      // Создание — самое важное для тестовых данных
      allow create: if isAuthenticated() && 
                      isValidMonth(request.resource.data) &&
                      (isAdmin() || 
                       (request.resource.data.uid == request.auth.uid && 
                        monthDocId.startsWith(request.auth.uid + "_")));

      // Обновление — только свои данные
      allow update: if isAuthenticated() && 
                      resource.data.uid == request.auth.uid &&
                      isValidMonth(request.resource.data);

      // Удаление — только свои или админ
      allow delete: if isAuthenticated() && 
                      (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ====================== ЗАПРЕТ ВСЕГО ОСТАЛЬНОГО ======================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}